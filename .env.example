# ============================================================
# ITS — Internal Ticketing System
# Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ──────────────────────────────────────────
# Database (SQL Server)
# ──────────────────────────────────────────

# SA password used by the sqlserver container.
MSSQL_SA_PASSWORD=REPLACE_ME_strong_password_1!

# Full ADO.NET connection string for the API container.
# The "sqlserver" hostname refers to the Docker service name.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=ITS;User Id=sa;Password=REPLACE_ME_strong_password_1!;TrustServerCertificate=True;MultipleActiveResultSets=True

# ──────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────

# Minimum 32 random characters. Generate with:
#   openssl rand -base64 48
Jwt__Key=REPLACE_ME_minimum_32_char_random_secret

# Public base URL of the API — used as token issuer and audience.
Jwt__Issuer=https://its.yourcompany.com
Jwt__Audience=https://its.yourcompany.com

# Token lifetime in hours. Default is 8 (no refresh endpoint exists).
Jwt__ExpiryHours=8

# ──────────────────────────────────────────
# Active Directory / LDAP
# ──────────────────────────────────────────

# Hostname or IP of your domain controller (LDAP port 389 / LDAPS 636).
ActiveDirectory__Host=your-dc.yourcompany.com
ActiveDirectory__Port=389

# Distinguished Name of the service account used to bind to LDAP.
ActiveDirectory__BindDn=CN=its-svc,OU=ServiceAccounts,DC=yourcompany,DC=com

# Password for the LDAP bind account.
ActiveDirectory__BindPassword=REPLACE_ME

# LDAP search base — the root OU under which users are found.
ActiveDirectory__SearchBase=DC=yourcompany,DC=com

# Short domain name (used for UPN suffix and AD sync).
ActiveDirectory__Domain=yourcompany.com

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────

Email__FromAddress=its@yourcompany.com
Email__FromName=ITS - Issue Tracking System
Email__SmtpHost=mail.yourcompany.com
Email__SmtpPort=25
# Set to true to require STARTTLS / SSL.
Email__EnableSsl=false
# Leave blank for anonymous relay.
Email__SmtpUsername=
Email__SmtpPassword=

# ──────────────────────────────────────────
# File Storage (Attachments)
# ──────────────────────────────────────────

# Public base URL used to build download links returned to clients.
FileStorage__BaseUrl=https://its.yourcompany.com/files

# ──────────────────────────────────────────
# AI Features
# ──────────────────────────────────────────

# Provider selection: Mock | OpenAI | AzureOpenAI
# Use "Mock" in development — returns canned responses, no API calls.
Ai__Provider=Mock

# ---- OpenAI (if Ai__Provider=OpenAI) ----
Ai__OpenAi__ApiKey=REPLACE_ME
Ai__OpenAi__Model=gpt-4o-mini

# ---- Azure OpenAI (if Ai__Provider=AzureOpenAI) ----
Ai__AzureOpenAi__Endpoint=https://your-resource.openai.azure.com/
Ai__AzureOpenAi__ApiKey=REPLACE_ME
Ai__AzureOpenAi__DeploymentName=gpt-4o-mini

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────

# Primary allowed origin (the frontend URL).
Cors__AllowedOrigins__0=https://its.yourcompany.com

# Add more origins as needed:
# Cors__AllowedOrigins__1=https://its-staging.yourcompany.com

# ──────────────────────────────────────────
# Frontend (Vite build-time variable)
# ──────────────────────────────────────────

# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=https://its.yourcompany.com

# ──────────────────────────────────────────
# Serilog
# ──────────────────────────────────────────

# Production: Warning | Staging: Information | Development: Debug
Serilog__MinimumLevel__Default=Warning
